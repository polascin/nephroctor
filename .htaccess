# ============================================================================
# nephroctor.com – Apache configuration for the WebSupport hosting
# Every block is guarded by <IfModule>, so a missing module degrades to
# "no effect" rather than a 500. See .audit.md, section 12.
# ============================================================================

AddDefaultCharset utf-8

# --- Correct MIME types -----------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json          .webmanifest
    AddType font/woff2                         .woff2
    AddType image/webp                         .webp
    AddType image/x-icon                       .ico
    AddType application/xml                    .xml
</IfModule>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    # No MIME sniffing.
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection (frame-ancestors below is the modern equivalent).
    Header always set X-Frame-Options "DENY"

    # Send the origin only, and only to equally secure destinations.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # The site needs none of these browser features. interest-cohort covers
    # legacy FLoC; browsing-topics covers the Topics API that replaced it.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"

    # Content Security Policy.
    #   script-src keeps 'unsafe-inline' because the theme bootstrap must run
    #   inline before first paint to avoid a flash of the wrong colour scheme,
    #   and static hosting cannot issue per-request nonces. Core assets stay
    #   same-origin. Clarity (script/connect/img, plus Bing beacon images) is
    #   allowed only so the consent-gated loader in clarity-consent.js can run
    #   after the visitor opts in; without consent that script never loads.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clarity.ms; style-src 'self'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://*.clarity.ms; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    # HSTS. Deliberately without includeSubDomains and without preload so that
    # a subdomain served over plain HTTP is not locked out. Raise only after
    # confirming every subdomain has a valid certificate.
    Header always set Strict-Transport-Security "max-age=15552000"

    # Cross-origin isolation basics.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# --- Canonical host and HTTPS ----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Direct legal shortcuts across all domains and aliases in a single hop.
    RewriteRule ^privacy/?$ https://nephroctor.com/legal/ochrana-osobnych-udajov.html [R=301,L]
    RewriteRule ^terms/?$ https://nephroctor.com/legal/podmienky-pouzivania.html [R=301,L]
    RewriteRule ^cookies/?$ https://nephroctor.com/legal/cookies.html [R=301,L]
    RewriteRule ^cookie-policy/?$ https://nephroctor.com/legal/cookies.html [R=301,L]
    RewriteRule ^accessibility/?$ https://nephroctor.com/legal/pristupnost.html [R=301,L]
    RewriteRule ^pristupnost/?$ https://nephroctor.com/legal/pristupnost.html [R=301,L]
    RewriteRule ^imprint/?$ https://nephroctor.com/legal/pravne-informacie.html [R=301,L]
    RewriteRule ^health-notice/?$ https://nephroctor.com/legal/zdravotne-upozornenie.html [R=301,L]
    RewriteRule ^disclaimer/?$ https://nephroctor.com/legal/zdravotne-upozornenie.html [R=301,L]
    RewriteRule ^zdravotne-upozornenie/?$ https://nephroctor.com/legal/zdravotne-upozornenie.html [R=301,L]
    RewriteRule ^legal/privacy\.html$ https://nephroctor.com/legal/ochrana-osobnych-udajov.html [R=301,L]
    RewriteRule ^legal/terms\.html$ https://nephroctor.com/legal/podmienky-pouzivania.html [R=301,L]
    RewriteRule ^legal/accessibility\.html$ https://nephroctor.com/legal/pristupnost.html [R=301,L]
    RewriteRule ^legal/imprint\.html$ https://nephroctor.com/legal/pravne-informacie.html [R=301,L]
    RewriteRule ^legal/cookie-policy\.html$ https://nephroctor.com/legal/cookies.html [R=301,L]
    RewriteRule ^legal/disclaimer\.html$ https://nephroctor.com/legal/zdravotne-upozornenie.html [R=301,L]
    RewriteRule ^legal/health-notice\.html$ https://nephroctor.com/legal/zdravotne-upozornenie.html [R=301,L]

    # 2. Consolidate every alias onto https://nephroctor.com in a single hop.
    #    www.nephroctor.com resolves to this same webspace and was answering 200
    #    with byte-identical content, i.e. the whole site under a second address.
    #    nephroctor.sk and nephroctor.eu are currently redirected upstream by the
    #    host (302); the rule below is the fallback if they are ever pointed
    #    straight at this webspace. The alias list is explicit on purpose, so a
    #    staging or preview hostname is never redirected away.
    RewriteCond %{HTTP_HOST} ^(www\.nephroctor\.com|(www\.)?nephroctor\.(sk|eu))$ [NC]
    RewriteRule ^ https://nephroctor.com%{REQUEST_URI} [R=301,L]

    # 3. Force HTTPS on the canonical host.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Legal URL shortcuts ----------------------------------------------------
# Canonical URLs stay the Slovak .html files listed in the sitemap. English
# lives in the same documents via ?lang=en; there are no separate EN files.
# /privacy, /terms, /cookies, /cookie-policy, /accessibility, /pristupnost,
# /imprint, /health-notice, /disclaimer, /zdravotne-upozornenie,
# /legal/privacy.html, /legal/terms.html, /legal/accessibility.html,
# /legal/imprint.html, /legal/cookie-policy.html, /legal/disclaimer.html and
# /legal/health-notice.html would 404 because nothing is at those paths; /legal
# is a real directory whose listing is blocked (403).
#
# RedirectMatch, not Redirect: Apache Redirect is prefix-based and would
# turn /legal/cookies.html into /legal/pravne-informacie.html/cookies.html.
# RewriteRule cannot intercept slashless /legal — Apache hands that URL to
# mod_dir (DirectorySlash) before per-directory rewrite runs.
# Query strings (?lang=en) are preserved on the 301.
# /security.txt is a convenience alias for RFC 9116 /.well-known/security.txt
# (basename security.txt is not blocked by the dotfile FilesMatch below).
<IfModule mod_alias.c>
    RedirectMatch 301 ^/privacy/?$ /legal/ochrana-osobnych-udajov.html
    RedirectMatch 301 ^/terms/?$ /legal/podmienky-pouzivania.html
    RedirectMatch 301 ^/cookies/?$ /legal/cookies.html
    RedirectMatch 301 ^/cookie-policy/?$ /legal/cookies.html
    RedirectMatch 301 ^/accessibility/?$ /legal/pristupnost.html
    RedirectMatch 301 ^/pristupnost/?$ /legal/pristupnost.html
    RedirectMatch 301 ^/imprint/?$ /legal/pravne-informacie.html
    RedirectMatch 301 ^/health-notice/?$ /legal/zdravotne-upozornenie.html
    RedirectMatch 301 ^/disclaimer/?$ /legal/zdravotne-upozornenie.html
    RedirectMatch 301 ^/zdravotne-upozornenie/?$ /legal/zdravotne-upozornenie.html
    RedirectMatch 301 ^/legal/privacy\.html$ /legal/ochrana-osobnych-udajov.html
    RedirectMatch 301 ^/legal/terms\.html$ /legal/podmienky-pouzivania.html
    RedirectMatch 301 ^/legal/accessibility\.html$ /legal/pristupnost.html
    RedirectMatch 301 ^/legal/imprint\.html$ /legal/pravne-informacie.html
    RedirectMatch 301 ^/legal/cookie-policy\.html$ /legal/cookies.html
    RedirectMatch 301 ^/legal/disclaimer\.html$ /legal/zdravotne-upozornenie.html
    RedirectMatch 301 ^/legal/health-notice\.html$ /legal/zdravotne-upozornenie.html
    RedirectMatch 301 ^/legal/?$ /legal/pravne-informacie.html
    RedirectMatch 301 ^/security\.txt$ /.well-known/security.txt
</IfModule>

# --- Caching ----------------------------------------------------------------
# Filenames are not content-hashed. HTML/CSS/JS must revalidate (ETag) so a
# deploy is visible immediately; fonts and images keep long TTLs.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 day"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 0 seconds"
    ExpiresByType application/javascript    "access plus 0 seconds"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType image/webp                "access plus 30 days"
    ExpiresByType image/png                 "access plus 30 days"
    ExpiresByType image/jpeg                "access plus 30 days"
    ExpiresByType image/x-icon              "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json application/xml \
        application/manifest+json image/svg+xml
</IfModule>

# --- Hardening --------------------------------------------------------------
# No directory listings.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Never serve dotfiles or repository leftovers.
<FilesMatch "^\.|(\.(md|yml|yaml|bak|log|sh)|~)$">
    Require all denied
</FilesMatch>

# No ErrorDocument override: serving index.html for a missing path would
# produce a soft 404 and confuse search engines. A plain 404 is correct.
